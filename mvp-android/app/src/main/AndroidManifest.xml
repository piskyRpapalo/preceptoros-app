<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional, consented HTTPS request to fixed Aduana endpoint only; no default telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:icon="@drawable/preceptor_launcher"
        android:label="PreceptorOS MVP"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.PreceptorOS">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".OpenWorldActivity"
            android:exported="false" />
    </application>
</manifest>
